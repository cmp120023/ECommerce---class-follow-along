<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* This dynamic title automatically pulls page headers from individual view definitions *@
    <title>@ViewData["Title"] - Billiard Game's Store</title>
    <script type="importmap"></script>
    @* Core external framework links for styling and application layouts *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Ecommerce.styles.css" asp-append-version="true" />
    @* This placeholder slot tells the layout engine where to inject style blocks specific to single pages *@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        @* The master top navigation bar component wrapper preset *@
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid px-4">
                @* Main branding label link that jumps straight back to the website dashboard home screen *@
                <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">Billiard Game's Store</a>
                @* Mobile responsive menu toggle icon button wrapper block *@
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    @* Left-Aligned Navigation List: Standard items accessible to all site traffic visitors *@
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-medium" asp-controller="Product" asp-action="Index">Product Listings</a>
                        </li>
                    </ul>

                    @* Right-Aligned Navigation List: Pushed completely to the right edge via 'ms-auto' to hold profiles *@
                    <ul class="navbar-nav ms-auto align-items-center">
                        @* Condition Check: If there is NO username saved in cookie memory, show anonymous visitor options *@
                        @if (Context.Session.GetString("Username") == null)
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link text-dark fw-medium" asp-controller="Member" asp-action="Login">Log in</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-primary px-3 rounded-pill fw-semibold shadow-sm" asp-controller="Member" asp-action="Register">Register</a>
                            </li>
                        }
                        else
                        {
                            @* Condition State: If a user is actively verified, print a friendly name badge and exit trigger *@
                            <li class="nav-item me-3">
                                <span class="navbar-text text-muted">
                                    Hello, <strong class="text-dark">@Context.Session.GetString("Username")</strong> 👋
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-danger px-3 rounded-pill fw-semibold" asp-controller="Member" asp-action="Logout">Log Out</a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    @* Central Body Workspace Container Layout Wrapper *@
    <div class="container">
        <main role="main" class="pb-3">
            @* This core instruction acts as a grand portal link. It loads your individual page views *@
            @* (like Index, Create, Edit, Login) directly inside this specific row segment frame. *@
            @RenderBody()
        </main>
    </div>

    @* Persistent page copyright base layout panel footer block *@
    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Today.Year - Billiard Game's Store - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @* Core programmatic scripting library setups needed to fuel transitions, menus, and layout alerts *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @* This footer script target placeholder slot pulls down custom tracking codes or layout triggers safely *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
