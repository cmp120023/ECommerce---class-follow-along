@* This line targets a single Product object from the database so we can display its specific details *@
@model Ecommerce.Models.Product

@{
    @* Dynamic title handler that appends the specific product name to the browser tab text *@
    ViewData["Title"] = $"Delete {Model.Title}";
}

<h1>Delete @Model.Title</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Product Details</h4>
    <hr />

    <dl class="row">
        @* Data Title Label (e.g., "Title") *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Title)
        </dt>
        @* Actual Database Value printed on screen (e.g., "Billiard Cue") *@
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>

        @* Data Price Label (e.g., "Price") *@
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Price)
        </dt>
        @* Actual Database Currency Value printed on screen *@
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Price)
        </dd>
    </dl>

    @* This form targets the Delete action inside the Product Controller when confirmed *@
    <form asp-action="Delete">
        @* Without this invisible line, the server won't know WHICH exact row to delete from SQL Server! *@
        <input type="hidden" asp-for="ProductId" />

        @* Red alert button that launches the permanent database drop sequence when clicked *@
        <input type="submit" value="Delete" class="btn btn-danger" /> |

        @* Safety link to return safely back to the product listing screen if you change your mind *@
        <a asp-action="Index">Back to Product listing</a>
    </form>
</div>
