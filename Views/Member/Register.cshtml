@* This line connects our HTML page to our temporary Registration checklist to ensure fields match *@
@model RegistrationViewModel

@* This section loads a dedicated CSS styling file exclusively for our authentication forms *@
@section Styles {
    <link rel="stylesheet" href="~/css/RegistrationFormStyle.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Register for a new account";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            @* This card design bundles the form layout and elevates it off the background with shadows *@
            <div class="card shadow border-0 auth-card">
                <div class="card-body p-4 p-md-5">

                    <h2 class="text-center mb-4 fw-bold text-primary auth-title">Create an Account</h2>
                    <p class="text-center text-muted mb-4">Please fill in your details to register.</p>

                    @* method="post" securely sends the filled-out form details back to our controller code *@
                    <form method="post">
                        @* This acts as a centralized notification box to show general form errors to the visitor *@
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                        @* Email Input Container *@
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                            @* This span catches email validation errors (like leaving it blank or forgetting the @ symbol) *@
                            <span asp-validation-for="Email" class="text-danger small d-block mt-1"></span>
                        </div>

                        @* Username Input Container *@
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-semibold"></label>
                            <input asp-for="Username" class="form-control" placeholder="Choose a username" />
                            @* This alerts the user if their username contains restricted special symbols or spaces *@
                            <span asp-validation-for="Username" class="text-danger small d-block mt-1"></span>
                        </div>

                        @* Date of Birth Input Container *@
                        <div class="mb-3">
                            <label asp-for="DateOfBirth" class="form-label fw-semibold">Date of Birth</label>
                            @* type="date" automatically pulls up a native clickable calendar pop-up window *@
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small d-block mt-1"></span>
                        </div>

                        @* Password Input Container *@
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-semibold"></label>
                            @* type="password" replaces text with hidden circles so onlookers can't see the password *@
                            <input asp-for="Password" class="form-control" type="password" placeholder="Create a strong password" />
                            <span asp-validation-for="Password" class="text-danger small d-block mt-1"></span>
                        </div>

                        @* Confirm Password Input Container *@
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Repeat your password" />
                            @* This span instantly lights up if the second password doesn't match the first one exactly *@
                            <span asp-validation-for="ConfirmPassword" class="text-danger small d-block mt-1"></span>
                        </div>

                        @* Create Account Button: Fires the registration bundle up to the web server when clicked *@
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">Create Account</button>
                        </div>

                        @* A quick helper link to jump straight to the log in screen if they already have an account *@
                        <div class="text-center mt-3">
                            <span class="text-muted small">Already have an account? </span>
                            <a asp-action="Login" class="small text-decoration-none fw-semibold">Log in</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

@* This section handles live form verification scripts before the page renders in the browser *@
@section Scripts {
    @{
        @* This helper includes background script tools to flag form mistakes instantly without making the page reload *@
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
